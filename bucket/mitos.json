    "649f81fc9cbe583492a9194d6cc7f84c5af7a21ffc020b252e5a763df1e6a5a6",
    "4d565b1bb8f522cd1fadfda5cf07417a390d2c54a969be4e70e8d8f0bdc15065"
  ],
  "architecture": {
    "64bit": {
      "installer": {
        "file": "install.ps1",
        "args": ["$dir", "64bit"]
